# =========================================================================
# Vercel & Next.js Fullstack Environment Variables
# Add these directly in your Vercel Project Settings (Settings -> Environment Variables)
# =========================================================================

# Database Configuration (MongoDB Atlas Connection URI)
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority

# Site URL
NEXT_PUBLIC_SITE_URL=https://adityasahubuilds.dev

# Authentication Secrets
JWT_SECRET=your_super_secret_jwt_random_string_here_12345
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_random_string_here_12345

# Admin Credentials (Initial auto-seed defaults if database is empty)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@adityasahu.dev
ADMIN_PASSWORD=AdminSecurePass123!

# Contact Form & Email Notifications (Optional - Brevo HTTP API)
BREVO_API_KEY=your_brevo_api_key_here
CONTACT_RECEIVER_EMAIL=your_email@gmail.com

# Media Asset Storage (Optional - Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
