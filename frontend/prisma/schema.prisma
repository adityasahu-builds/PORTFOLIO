generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------
// 1. USER MODEL (Admin Authentication)
// ------------------------------------------
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  password     String
  role         String   @default("admin")
  refreshToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

// ------------------------------------------
// 2. PROJECT MODEL
// ------------------------------------------
model Project {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  description      String
  shortDescription String?
  longDescription  String?
  techStack        String[] @default([])
  technologies     String[] @default([])
  gitHubUrl        String?
  githubUrl        String?
  liveUrl          String?
  thumbnail        String?
  image            String?
  galleryImages    String[] @default([])
  featured         Boolean  @default(false)
  category         String   @default("General")
  displayOrder     Int      @default(0)
  order            Int      @default(0)
  status           String   @default("Completed")
  number           String?
  problemStatement String?
  solution         String?
  keyFeatures      String[] @default([])
  accentColor      String?
  mockupType       String?  @default("portfolio")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("projects")
}

// ------------------------------------------
// 3. SKILL MODEL
// ------------------------------------------
model Skill {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  category     String
  icon         String?
  iconName     String?
  imageUrl     String?
  skillLevel   Int      @default(80)
  experience   Int      @default(1)
  description  String?
  featured     Boolean  @default(false)
  displayOrder Int      @default(0)
  status       String   @default("Active")
  x            String   @default("50%")
  y            String   @default("50%")
  connections  String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("skills")
}

// ------------------------------------------
// 4. EXPERIENCE MODEL
// ------------------------------------------
model Experience {
  id               String    @id @default(cuid())
  companyName      String
  role             String
  employmentType   String    @default("Full-time")
  location         String?
  startDate        DateTime
  endDate          DateTime?
  currentlyWorking Boolean   @default(false)
  companyLogo      String?
  companyWebsite   String?
  description      String?
  responsibilities String[]  @default([])
  achievements     String[]  @default([])
  technologiesUsed String[]  @default([])
  displayOrder     Int       @default(0)
  featured         Boolean   @default(false)
  status           String    @default("Active")
  iconName         String    @default("Briefcase")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("experiences")
}

// ------------------------------------------
// 5. EDUCATION MODEL
// ------------------------------------------
model Education {
  id                 String    @id @default(cuid())
  institutionName    String
  degree             String
  fieldOfStudy       String
  location           String?
  startDate          DateTime
  endDate            DateTime?
  currentlyStudying  Boolean   @default(false)
  grade              String?
  description        String?
  achievements       String[]  @default([])
  institutionLogo    String?
  institutionWebsite String?
  displayOrder       Int       @default(0)
  featured           Boolean   @default(false)
  status             String    @default("Active")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("educations")
}

// ------------------------------------------
// 6. CERTIFICATE MODEL
// ------------------------------------------
model Certificate {
  id            String   @id @default(cuid())
  title         String
  issuer        String
  issueDate     String
  expiryDate    String?  @default("")
  doesNotExpire Boolean  @default(false)
  credentialId  String?  @default("")
  credentialUrl String?  @default("")
  imageUrl      String?  @default("")
  skills        String[] @default([])
  featured      Boolean  @default(false)
  displayOrder  Int      @default(0)
  status        String   @default("Active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("certificates")
}

// ------------------------------------------
// 7. PERSONAL INFO MODEL
// ------------------------------------------
model PersonalInfo {
  id          String   @id @default(cuid())
  hero        Json
  about       Json
  contact     Json
  socialLinks Json
  seo         Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("personal_info")
}

// ------------------------------------------
// 8. CONTACT MODEL
// ------------------------------------------
model Contact {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contacts")
}

// ------------------------------------------
// 9. VISITOR SESSION MODEL
// ------------------------------------------
model VisitorSession {
  id              String   @id @default(cuid())
  sessionId       String   @unique
  ipHash          String   @default("")
  country         String   @default("Unknown")
  city            String   @default("Unknown")
  deviceType      String   @default("Unknown")
  browser         String   @default("Unknown")
  os              String   @default("Unknown")
  screenSize      String   @default("Unknown")
  referralSource  String   @default("Direct")
  landingPage     String   @default("/")
  visitTime       DateTime @default(now())
  lastActiveTime  DateTime @default(now())
  sessionDuration Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("visitor_sessions")
}

// ------------------------------------------
// 10. ANALYTICS EVENT MODEL
// ------------------------------------------
model AnalyticsEvent {
  id        String   @id @default(cuid())
  sessionId String
  eventName String
  pagePath  String   @default("/")
  details   Json?
  timestamp DateTime @default(now())

  @@map("analytics_events")
}

// ------------------------------------------
// 11. MEDIA MODEL
// ------------------------------------------
model Media {
  id           String   @id @default(cuid())
  originalName String
  publicId     String   @unique
  secureUrl    String
  width        Int?
  height       Int?
  size         Int
  mimeType     String
  folder       String   @default("portfolio")
  tags         String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("media")
}
